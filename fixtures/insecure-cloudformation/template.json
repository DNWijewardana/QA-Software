{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FIXTURE — intentionally insecure CloudFormation template (spec X.3). NOT for real use.",
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": { "AccessControl": "PublicRead" }
    },
    "SG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "web",
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": "0.0.0.0/0" }
        ]
      }
    },
    "Volume": {
      "Type": "AWS::EC2::Volume",
      "Properties": { "Size": 8, "Encrypted": false }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Policies": [
          {
            "PolicyName": "admin",
            "PolicyDocument": {
              "Statement": [{ "Effect": "Allow", "Action": "*", "Resource": "*" }]
            }
          }
        ]
      }
    },
    "DB": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": { "Engine": "postgres", "MasterUserPassword": "supersecretpw123" }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": { "ImageId": "ami-123", "AssociatePublicIpAddress": true }
    }
  }
}
