{
  "name": "qa-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Universal Software Quality Assurance & Testing Platform (Master Prompt v2.0)",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/contracts",
    "packages/engines",
    "packages/orchestrator",
    "packages/reporters",
    "packages/jobs",
    "apps/cli",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx apps/cli/src/index.ts",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "web": "npm -w @qa/web run dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
